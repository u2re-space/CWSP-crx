{
    "name": "cwsp-crx",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "npm run build:crx",
        "build:pwa": "rm -rf ./dist && node ./scripts/run-vite.mjs build && node ./scripts/normalize-worker-names.mjs",
        "postbuild:pwa": "node ./scripts/copy-pwa-to-endpoint.mjs",
        "build:crx": "rm -rf ./dist && node ./scripts/run-vite.mjs build --config vite.config.js --mode crx && node ./scripts/normalize-worker-names.mjs",
        "build:crx:lite": "VITE_ENABLED_VIEWS=viewer,editor,settings,history,home,print vite build --config vite.config.js --mode crx",
        "build:all": "node ./scripts/build.mjs crx",
        "build:modules": "node ./scripts/build.mjs modules",
        "preview": "node ./scripts/run-vite.mjs preview",
        "start": "npm run dev",
        "dev": "npm run build:crx",
        "test:test": "echo 'No tests configured for cwsp-crx' && exit 0"
    },
    "browserslist": [
        "last 1 chrome version",
        "last 1 edge version"
    ],
    "devDependencies": {
        "@cap-js-community/websocket": "^1.11.1",
        "@capacitor/clipboard": "^8.0.1",
        "@capacitor/core": "^8.5.1",
        "@crxjs/vite-plugin": "^2.7.1",
        "@jsquash/jpeg": ">=1.6.0",
        "@jsquash/png": ">=3.1.1",
        "@phosphor-icons/core": ">=2.1.1",
        "@rolldown/binding-linux-x64-gnu": "1.2.7",
        "@toon-format/toon": ">=4.1.1",
        "@types/chrome": "^0.2.9",
        "@types/sanitize-html": ">=2.16.1",
        "autoprefixer": ">=10.5.5",
        "baseline-browser-mapping": ">=2.11.21",
        "capacitor-native-settings": "^8.2.0",
        "chrome-types": "^0.1.443",
        "country-flag-emoji-polyfill": ">=0.1.10",
        "cssnano": ">=9.0.3",
        "cssnano-preset-advanced": "^9.0.3",
        "culori": ">=4.0.2",
        "docx": ">=9.7.1",
        "dompurify": ">=3.4.14",
        "esbuild": ">=0.28.2",
        "fflate": "^0.8.3",
        "isomorphic-dompurify": ">=4.1.0",
        "jsdom": ">=30.0.1",
        "jsox": ">=1.2.128",
        "lightningcss-linux-x64-gnu": "^1.33.0",
        "marked": ">=18.0.11",
        "marked-katex-extension": ">=5.1.12",
        "mathml-to-latex": ">=1.8.0",
        "pako": "^3.0.1",
        "postcss-discard-duplicates": ">=9.0.2",
        "postcss-import": ">=17.0.0",
        "postcss-preset-env": ">=11.5.1",
        "postcss-remove-duplicate-values": ">=2.0.0",
        "prettier": ">=3.9.6",
        "quill": "^2.0.3",
        "sass": ">=1.104.0",
        "tar": "^7.5.22",
        "temml": ">=0.13.5",
        "turndown": ">=7.2.4",
        "typescript": "^6.0.3",
        "vite": "^8.2.2",
        "vite-bundle-analyzer": ">=1.3.9",
        "vite-plugin-bundle-prefetch": ">=0.0.4",
        "vite-plugin-compression2": "^2.5.3",
        "vite-plugin-external": ">=8.0.3",
        "vite-plugin-jspm": ">=0.6.3",
        "vite-plugin-mcp": "^0.3.2",
        "vite-plugin-optimizer": ">=1.4.3",
        "vite-plugin-pwa": "^1.3.0",
        "vite-plugin-singlefile": ">=2.3.3",
        "vite-plugin-static-copy": ">=4.1.1",
        "vite-tsconfig-paths": ">=6.1.1"
    }
}
