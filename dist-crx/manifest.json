{
  "manifest_version": 3,
  "name": "CrossWord",
  "description": "Snip & Process (AI/OCR), Markdown Viewer, Math/Content Conversion (LaTeX/MathML/HTML/Markdown)",
  "version": "1.0.0",
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "CrossWord"
  },
  "chrome_url_overrides": {},
  "options_ui": {
    "page": "settings/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "scripting",
    "webRequest",
    "clipboardWrite",
    "clipboardRead",
    "contextMenus",
    "nativeMessaging",
    "tabCapture",
    "downloads",
    "webNavigation",
    "offscreen",
    "notifications",
    "commands",
    "desktopCapture"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https: ws: wss: http://127.0.0.1:* http://localhost:* https://cdn.jsdelivr.net https://unpkg.com data: blob:; frame-src https://u2re.space https://*.u2re.space *;",
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' 'wasm-eval' http://**/* https://**/* file://**/*; child-src 'self';"
  },
  "host_permissions": [
    "<all_urls>",
    "file://**/*",
    "file:///**/*",
    "https://u2re.space/*",
    "https://*.u2re.space/*"
  ],
  "content_scripts": [
    {
      "js": [
        "assets/main.ts-loader.js"
      ],
      "matches": [
        "<all_urls>",
        "file:///**/*",
        "file://**/*"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "markdown/viewer.html",
        "offscreen/*",
        "app/*",
        "assets/*",
        "chunks/*",
        "vendor/*",
        "fest/*",
        "com/*",
        "core/*",
        "views/*",
        "shells/*",
        "workers/**/*",
        "pwa/*",
        "icons/*"
      ],
      "use_dynamic_url": false
    },
    {
      "matches": [
        "<all_urls>",
        "file://*/*",
        "file:///*"
      ],
      "resources": [
        "app/background.js",
